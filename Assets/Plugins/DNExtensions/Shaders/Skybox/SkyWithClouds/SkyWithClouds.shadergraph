{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "2e0b3b6c2e3c4ae7a475a4857e584cc0",
    "m_Group": {
        "m_Id": "1dacbacaed074bafb122d313b1a2194e"
    },
    "m_Name": "StarsFunc (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -3085.999755859375,
            "y": 398.6666259765625,
            "width": 237.3330078125,
            "height": 240.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "9c13c4a3119b4a22a8ea7822261cf682"
        },
        {
            "m_Id": "99be7e4b282a4f9884d487b7cac54011"
        },
        {
            "m_Id": "8133496c0a154b3d8eedfd764cabf833"
        },
        {
            "m_Id": "03165914d39e42c794e5682fa9cf74cd"
        },
        {
            "m_Id": "5b0b77934ebd45d18a5aa2a2d3a7071b"
        },
        {
            "m_Id": "d7e5b0fe23964f39945d72c6aa61c106"
        },
        {
            "m_Id": "3d51a1ac50004e91ade6422aad983bed"
        },
        {
            "m_Id": "af14eb8699604ee8ace1b8c58eb095b5"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 0,
    "m_FunctionName": "StarsFunc",
    "m_FunctionSource": "541e70577b3cadc489ddd911c5eb5dd6",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// Name: StarsFunc\r\n// Inputs: WorldPosition(3), Color(4), Density(1), Size(1), HorizonFade(1)\r\n// Output: Out(4)\r\n\r\nfloat2 hash(float2 p)\r\n{\r\n    p = float2(dot(p, float2(127.1, 311.7)), dot(p, float2(269.5, 183.3)));\r\n    return frac(sin(p) * 43758.5453);\r\n}\r\n\r\nvoid StarsFunc_float(float3 WorldPosition, float4 Color, float Density, float Size, float HorizonFade, out float4 Out)\r\n{\r\n    float3 dir = normalize(WorldPosition);\r\n    Out = float4(0, 0, 0, 0);\r\n    if (dir.y <= 0) return;\r\n\r\n    float2 uv = float2(atan2(dir.z, dir.x), asin(clamp(dir.y, -1.0, 1.0)));\r\n    uv *= Density / 3.14159;\r\n\r\n    float2 cellId = floor(uv);\r\n    float2 cellFrac = frac(uv);\r\n\r\n    float star = 0;\r\n    float brightness = 0;\r\n\r\n    [unroll] for (int x = -1; x <= 1; x++)\r\n    [unroll] for (int y = -1; y <= 1; y++)\r\n    {\r\n        float2 offset = float2(x, y);\r\n        float2 h = hash(cellId + offset);\r\n        float d = length(offset + h - cellFrac);\r\n        float s = smoothstep(Size, 0.0, d);\r\n        if (s > star) { star = s; brightness = h.x; }\r\n    }\r\n\r\n    float horizonMask = saturate(dir.y / HorizonFade);\r\n    Out = Color * (star * brightness * horizonMask);\r\n}"
}

