.spline-item-container {
    padding: 4px;
    flex-shrink: 0;
}

.spline-header-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 20px;
}

.foldout-toggle {
    width: 16px;
    height: 16px;
    margin-right: 2px;
    padding: 0;
    flex-shrink: 0;
    background-color: transparent;
    border-width: 0;
}

.foldout-toggle .spline-arrow,
.foldout-toggle .group-arrow {
    width: 16px;
    height: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    color: rgb(104, 104, 104);
    cursor: pointer;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    background-color: transparent;
    border-width: 0;
}

.spline-enabled-toggle {
    margin: 0;
    margin-right: 0;
    margin-bottom: 0;
    flex-shrink: 0;
}

.spline-name-text {
    margin: 0;
    padding: 0;
    padding-bottom: 2px;
    padding-left: 8px;
    font-size: 12px;
    color: rgb(255, 255, 255);
    flex-grow: 1;
    cursor: pointer;
    overflow: hidden;
}

.spline-icons-container {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-left: 6px;
    margin-right: 14px;
}

.spline-operation-icons {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.spline-icon {
    width: 16px;
    height: 16px;
    margin-left: 8px;
    -unity-background-scale-mode: scale-and-crop;
}

.operation-icon-toggle {
    width: 22px;
    height: 22px;
    min-width: 22px;
    min-height: 22px;
    padding: 0;
    margin-right: 6px;
    justify-content: center;
    align-items: center;
    background-color: transparent;
    border-width: 0;
}

.operation-icon-toggle-last {
    margin-right: 0;
}

.icon-toggle {
    width: 22px;
    height: 22px;
    min-width: 22px;
    min-height: 22px;
    padding: 0;
    margin-left: 4px;
    background-color: transparent;
    border-width: 0;
    justify-content: center;
    align-items: center;
}

.icon-toggle-icon {
    width: 16px;
    height: 16px;
    margin: 2px;
    -unity-background-scale-mode: scale-and-crop;
}

.operation-icon {
    width: 18px;
    height: 18px;
    -unity-background-scale-mode: scale-and-crop;
}

.spline-item-content {
    margin-top: 4px;
}

.spline-controls {
    flex-grow: 1;
    min-width: 0;
    margin-right: 16px;
}

.spline-action-button {
    min-width: 20px;
    min-height: 20px;
    width: 20px;
    height: 20px;
    margin-left: 8px;
    margin-right: 0;
    padding: 0;
    background-color: transparent;
    border-color: transparent;
    color: rgb(255, 255, 255);
    border-width: 0;
    border-radius: 0;
    flex-shrink: 0;
    opacity: 0;
}

.noise-foldout {
    margin-top: 4px;
    padding: 0;
}

.noise-foldout-content {
    margin-top: 2px;
}

.noise-inline-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.noise-inline-row .noise-texture-field {
    flex-grow: 1;
    margin-right: 8px;
}

.noise-invert-toggle {
    align-self: center;
    width: 22px;
    height: 22px;
    min-width: 22px;
    min-height: 22px;
    padding: 0;
    margin-left: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 0;
    margin-top: -8px;
    padding-top: 0;
    top: 8px;
}

.noise-offset-field {
    margin-left: 0;
    padding-left: 0;
}

.noise-offset-field .unity-base-field__label {
    margin-left: 1px;
    margin-right: 0;
    padding-left: 0;
}

.curve-field-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
    margin-left: 1px;
    padding-right: 0;
    margin-right: 0;
    padding-left: 0;
}

.curve-field-row > .unity-curve-field {
    flex-grow: 1;
    min-width: 0;
    background-color: transparent;
    padding-left: 0;
    margin-left: 1px;
}

.curve-field-row > .curve-preset-dropdown-container {
    flex-grow: 1;
    min-width: 0;
}

.curve-field-row > .curve-preset-dropdown-container > .unity-curve-field {
    flex-grow: 1;
    min-width: 0;
    background-color: transparent;
    padding-left: 0;
    margin-left: 1px;
}

.spline-item-container:hover .spline-action-button {
    opacity: 1;
}

.spline-action-button:hover {
    background-color: rgba(58, 58, 58, 0);
    border-color: transparent;
    color: rgb(255, 255, 255);
}

.spline-action-button:active {
    background-color: rgba(42, 42, 42, 0);
    border-color: transparent;
}

.spline-action-icon {
    width: 16px;
    height: 16px;
    -unity-background-scale-mode: scale-and-crop;
    -unity-image-tint-color: rgb(204, 204, 204);
    margin: 2px;
}

.spline-action-button:hover .spline-action-icon {
    -unity-image-tint-color: rgb(255, 255, 255);
}

.delete-spline-button .spline-action-icon {
    -unity-image-tint-color: rgb(255, 107, 107);
}

.delete-spline-button:hover .spline-action-icon {
    -unity-image-tint-color: rgb(255, 142, 142);
}

.spline-preview {
    width: 80px;
    height: 80px;
    min-width: 80px;
    min-height: 80px;
    justify-content: center;
    align-items: center;
}

.preview-thumbnail {
    width: 100%;
    height: 100%;
}

.no-preview-label {
    -unity-text-align: middle-center;
    opacity: 0.5;
}

.group-item-container {
    padding: 4px;
}

.group-header-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    cursor: pointer;
}

.group-arrow {
    width: 16px;
    height: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    color: rgb(204, 204, 204);
    margin-right: 2px;
    user-select: none;
    margin-left: 0;
    padding-left: 0;
    left: 2px;
    top: 2px;
}

.group-name-text {
    flex-grow: 1;
    font-weight: bold;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    user-select: none;
    margin-bottom: 0;
    margin-top: 0;
    padding-bottom: 0;
    top: auto;
    bottom: 0;
}

.spline-item-nested {
    margin-left: 14px;
}

.conditional-section {
    margin-top: 4px;
    margin-bottom: 4px;
}

.spline-item-content {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.spline-item-content .spline-preview {
    margin-left: 0;
}

.plain-toggle .unity-label {
    -unity-font-style: normal;
}

.slider-field-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.slider-field-row .unity-slider,
.slider-field-row .unity-base-slider,
.slider-field-row .unity-slider-int {
    flex-grow: 1;
    min-width: 140px;
    flex-basis: 0;
    margin-right: 8px;
    margin-bottom: 0;
}

.slider-field-row .unity-float-field,
.slider-field-row .unity-integer-field {
    width: 60px;
    min-width: 60px;
    margin-bottom: 0;
}

.slider-field-row .unity-label {
    min-width: 90px;
    margin-right: 8px;
    padding-left: 0;
}

.slider-field-row .unity-slider__label {
    min-width: 90px;
    margin-right: 8px;
    margin-left: 0;
    padding-left: 0;
}

.spline-tab-content .unity-toggle {
    margin-bottom: 8px;
    margin-left: 0;
    padding-left: 0;
}

.spline-tabs {
    flex-direction: row;
    margin-bottom: 0;
    border-bottom: 1px solid rgb(64, 64, 64);
    background-color: transparent;
    border-radius: 3px 3px 0 0;
    padding: 0;
}

.spline-tab-button {
    min-width: 80px;
    height: 28px;
    margin-right: 0;
    border-radius: 0;
    flex-grow: 1;
    background-color: transparent;
    border: none;
    border-right: 1px solid rgb(64, 64, 64);
    border-bottom: 1px solid rgb(64, 64, 64);
    color: rgb(204, 204, 204);
    font-size: 11px;
    padding: 0 8px;
    -unity-text-align: middle-center;
}

.spline-tab-button-iconized {
    min-width: 48px;
    flex-grow: 0;
    flex-shrink: 0;
    padding: 0;
    border-radius: 4px;
    margin-right: 4px;
    background-color: transparent;
}

.spline-tab-button-expanded {
    min-width: 106px;
    flex-grow: 1;
    background-color: rgb(42, 42, 42);
}

.spline-tab-button-content {
    height: 100%;
    width: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.spline-tab-button-indicator-container {
    position: absolute;
    right: 2px;
    top: 0;
    bottom: 0;
    width: 16px;
    align-items: center;
    justify-content: center;
}

.spline-tab-button-icon {
    width: 14px;
    height: 14px;
    min-width: 14px;
    min-height: 14px;
    -unity-background-scale-mode: scale-to-fit;
}

.spline-tab-button-label {
    margin-left: 6px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

.spline-tab-button-indicator {
    font-size: 11px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    margin-right: 0;
    padding-right: 0;
    padding-left: 2px;
    padding-top: 0;
    padding-bottom: 0;
}

.spline-tab-button-last {
    border-right: none;
    border-radius: 0 3px 0 0;
}

.spline-tab-button-first {
    border-radius: 3px 0 0 0;
}

.spline-tab-button:hover {
    background-color: rgb(58, 58, 58);
    color: rgb(255, 255, 255);
}

.spline-tab-button-active {
    background-color: rgb(42, 42, 42);
    border-bottom: 1px solid transparent;
    color: rgb(255, 255, 255);
    font-weight: bold;
}

.spline-tab-content {
    margin-top: 8px;
    margin-bottom: 4px;
    background-color: transparent;
    border: 1px solid rgb(64, 64, 64);
    border-top: none;
    border-radius: 0 0 3px 3px;
    min-height: 60px;
}

.override-mode-content {
    min-height: 80px;
}

.override-brush-content {
    min-height: 280px;
}

.override-paint-content {
    min-height: 120px;
}

.group-item-content {
    margin-top: 4px;
}
